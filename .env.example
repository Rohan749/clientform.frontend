# ---------------------------------------------------------------------------
# ClientForm frontend — environment variables
# Local development: copy this file to .env.
# Netlify: add these under Site configuration → Environment variables, then redeploy
# (Vite bakes them into the build). These values are public: never put secrets here.
#
# The frontend has no Supabase keys. All auth, data and uploads go through the backend.
# ---------------------------------------------------------------------------

# Backend API base URL, without a trailing slash.
# Local development: leave empty (Vite proxies /api to http://localhost:4000).
# Production: REQUIRED, e.g. https://p01--clientform-api--xxxx.code.run
VITE_API_URL=

# Public origin shown in share links, e.g. https://clientform.netlify.app or your custom domain.
# Defaults to the current browser origin.
VITE_PUBLIC_APP_URL=
